{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S2F clip manifest record (CSV columns)",
  "type": "object",
  "required": ["clip_id", "file_path", "label", "speaker_id", "generator", "transcript", "central_phoneme", "previous_phoneme", "next_phoneme", "compression", "split", "source_id"],
  "properties": {
    "clip_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,100}$"},
    "file_path": {"type": "string", "minLength": 1},
    "label": {"enum": ["real", "fake"]},
    "speaker_id": {"type": "string", "minLength": 1},
    "generator": {"type": "string", "minLength": 1},
    "transcript": {"type": "string", "minLength": 1},
    "central_phoneme": {"type": "string", "minLength": 1},
    "previous_phoneme": {"type": "string", "minLength": 1},
    "next_phoneme": {"type": "string", "minLength": 1},
    "compression": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "val", "test"]},
    "source_id": {"type": "string", "minLength": 1},
    "evidence_type": {"type": "string"}
  },
  "additionalProperties": true,
  "$comment": "Schema describes records; Python CSV validator additionally checks paths, duplicate hashes, source-family and protocol-specific speaker/generator leakage."
}
